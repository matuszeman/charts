multi support:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME-one
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-one-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`one.example.com`) && PathPrefix(`/`)
          services:
            - name: RELEASE-NAME-one
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME-two
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-two-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`two.example.com`) && PathPrefix(`/`)
          services:
            - name: RELEASE-NAME-two
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
should create IngressRoute:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
should create IngressRoute with Exact pathType:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && Path(`/exact`)
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
should create IngressRoute with RegularExpression pathType:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathRegexp(`/api/v[0-9]+`)
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
should support external service backend:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          services:
            - name: my-external-svc
              port: 8080
      tls:
        secretName: RELEASE-NAME-tls
when forwardAuth enabled, should add middleware and generate Middleware resource:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          middlewares:
            - name: RELEASE-NAME-public-forwardauth
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public-forwardauth
    spec:
      forwardAuth:
        address: http://oauth2proxy.auth.svc.cluster.local/oauth2/auth
        authResponseHeaders:
          - Auth-Proxy-Email
          - Auth-Proxy-Groups
        trustForwardHeader: true
when forwardAuth has no appName, should build the middleware from the full inline spec:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          middlewares:
            - name: RELEASE-NAME-public-forwardauth
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public-forwardauth
    spec:
      forwardAuth:
        addAuthCookiesToResponse:
          - Session
        address: http://custom.auth.svc.cluster.local/verify
        authRequestHeaders:
          - Accept
          - X-Forwarded-Method
        authResponseHeaders:
          - X-Custom-User
          - X-Custom-Groups
        authResponseHeadersRegex: ^X-Custom-
        authSigninURL: https://auth.example.com/sign_in
        forwardBody: true
        headerField: X-Auth-User
        maxBodySize: 1048576
        maxResponseBodySize: 2097152
        preserveLocationHeader: true
        preserveRequestMethod: true
        tls:
          caSecret: auth-ca
          certSecret: auth-cert
          insecureSkipVerify: true
        trustForwardHeader: true
when forwardAuth passthrough set, should add a higher-priority route to the provider service and no middleware on it:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/oauth2`)
          priority: 100
          services:
            - name: oauth2proxy
              namespace: auth
              port: 80
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          middlewares:
            - name: RELEASE-NAME-public-forwardauth
          priority: 10
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public-forwardauth
    spec:
      forwardAuth:
        address: http://oauth2proxy.auth.svc.cluster.local/oauth2/auth
        authResponseHeaders:
          - Auth-Proxy-Email
          - Auth-Proxy-Groups
        trustForwardHeader: true
when host is FQDN (no domain), should use host directly:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`myapp.example.com`) && PathPrefix(`/`)
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
when passthrough set without appName, should route the path to the inline service:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/oauth2/`)
          priority: 100
          services:
            - name: oauth2proxy
              namespace: auth
              port: 4180
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          middlewares:
            - name: RELEASE-NAME-public-forwardauth
          priority: 10
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public-forwardauth
    spec:
      forwardAuth:
        address: http://custom.auth.svc.cluster.local/verify
when service.enabled and ingressRoute.service.port is set, use port override:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          services:
            - name: RELEASE-NAME
              port: 9090
      tls:
        secretName: RELEASE-NAME-tls
when stripPathPrefix is true, should create StripPrefix Middleware and reference it:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/api`)
          middlewares:
            - name: RELEASE-NAME-public-strippathprefix
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        secretName: RELEASE-NAME-tls
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public-strippathprefix
    spec:
      stripPrefix:
        prefixes:
          - /api
when tlsOption clientAuth uses only secretNames, should reference existing secrets:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        options:
          name: RELEASE-NAME-public
        secretName: RELEASE-NAME-tls
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: TLSOption
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      clientAuth:
        clientAuthType: VerifyClientCertIfGiven
        secretNames:
          - existing-ca-secret
          - another-ca-secret
      minVersion: VersionTLS12
when tlsOption is set, should generate TLSOption and reference it in IngressRoute:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      entryPoints:
        - websecure
      routes:
        - kind: Rule
          match: Host(`test.example.com`) && PathPrefix(`/`)
          services:
            - name: RELEASE-NAME
              port: 80
      tls:
        options:
          name: RELEASE-NAME-public
        secretName: RELEASE-NAME-tls
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: TLSOption
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      cipherSuites:
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
      clientAuth:
        clientAuthType: VerifyClientCertIfGiven
        secretNames:
          - RELEASE-NAME-config-mtls-ca
      maxVersion: VersionTLS13
      minVersion: VersionTLS12
      sniStrict: true
