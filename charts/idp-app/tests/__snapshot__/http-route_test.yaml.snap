when stripPathPrefix is true, should add URLRewrite filter:
  1: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      annotations:
        traefik.io/controller: traefik-public
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: app-name
        app.kubernetes.io/version: 0.1.0
        traefik.io/controller: traefik-public
      name: RELEASE-NAME-public
    spec:
      hostnames:
        - test.example.com
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: traefik-public
          namespace: gateway-test
      rules:
        - backendRefs:
            - group: ""
              kind: Service
              name: RELEASE-NAME
              namespace: NAMESPACE
              port: 80
              weight: 1
          filters:
            - type: URLRewrite
              urlRewrite:
                path:
                  replacePrefixMatch: /
                  type: ReplacePrefixMatch
          matches:
            - path:
                type: PathPrefix
                value: /api
